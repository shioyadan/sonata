{
  "name": "sonata",
  "version": "0.1.0",
  "private": true,
  "description": "A cinematic WebGL processor trace visualizer",
  "license": "BSD-3-Clause",
  "author": "Ryota Shioya",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/shioyadan/sonata.git"
  },
  "engines": {
    "node": ">=22.23.2"
  },
  "scripts": {
    "build": "node scripts/build.cjs",
    "start": "node scripts/serve.cjs",
    "test": "node scripts/test.cjs",
    "test:server": "node scripts/check-server.cjs",
    "test:render": "electron --no-sandbox scripts/render.cjs",
    "test:smoke": "electron --no-sandbox scripts/render.cjs --smoke",
    "test:mobile": "electron --no-sandbox scripts/render.cjs --mobile",
    "test:styles": "electron --no-sandbox scripts/render.cjs --styles",
    "test:browser": "electron --no-sandbox scripts/render.cjs --browser",
    "capture:flush": "electron --no-sandbox scripts/capture-flush.cjs",
    "demos:generate": "node scripts/generate-samples.cjs",
    "demos:select": "node --import tsx scripts/select-traces.ts",
    "typecheck": "tsc --noEmit",
    "format": "prettier --write src scripts",
    "format:check": "prettier --check src scripts",
    "test:import": "electron --no-sandbox scripts/render.cjs --import",
    "core:generate": "node scripts/generate-core.cjs"
  },
  "devDependencies": {
    "@hpcc-js/wasm-zstd": "1.15.0",
    "@types/node": "22.20.2",
    "electron": "43.2.0",
    "prettier": "3.6.2",
    "tsx": "4.23.11",
    "typescript": "5.9.3"
  }
}
