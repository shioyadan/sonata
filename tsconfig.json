{
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "allowImportingTsExtensions": true,
    "strict": true,
    "noEmit": true,
    "types": ["node"],
    "lib": ["ES2023", "DOM", "DOM.Iterable"]
  },
  "include": [
    "src/**/*.cts",
    "scripts/check-types.cts",
    "scripts/check-browser.cts",
    "scripts/check-smoke.cts",
    "scripts/check-import.cts",
    "scripts/check-navigation.cts",
    "scripts/check-file-playback.cts",
    "scripts/browser-test.cts",
    "scripts/check-demo-loading.cts"
  ]
}
